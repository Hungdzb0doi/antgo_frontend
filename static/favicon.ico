<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100%" height="100%">
  <defs>
    <linearGradient id="antgoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FF7A1A"/>
      <stop offset="100%" stop-color="#FF5500"/>
    </linearGradient>
    <filter id="antGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#FF6600" flood-opacity="0.4"/>
    </filter>
  </defs>

  <g id="ant-lightning-mark" filter="url(#antGlow)">
    <!-- Râu kiến (Antennae) -->
    <path d="M 64 25 C 68 18 73 14 78 13" fill="none" stroke="url(#antgoGrad)" stroke-width="3" stroke-linecap="round"/>
    <path d="M 68 28 C 76 25 81 23 85 24" fill="none" stroke="url(#antgoGrad)" stroke-width="3" stroke-linecap="round"/>

    <!-- Đầu kiến (Ant Head) -->
    <path d="M 58 22 C 67 22 73 28 70 36 C 67 43 59 42 54 36 C 50 31 53 23 58 22 Z" fill="url(#antgoGrad)"/>
    <!-- Mắt kiến (Eye slit) -->
    <path d="M 62 28 Q 65 31 63 33" stroke="#18181B" stroke-width="2" stroke-linecap="round" fill="none"/>

    <!-- Chân kiến (Ant Legs - Góc chuyển động siêu tốc) -->
    <!-- Chân trên -->
    <path d="M 50 38 L 44 26 L 38 28" fill="none" stroke="url(#antgoGrad)" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>
    <!-- Chân giữa -->
    <path d="M 44 48 L 30 42 L 22 49" fill="none" stroke="url(#antgoGrad)" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>
    <!-- Chân sau -->
    <path d="M 38 60 L 26 66 L 20 78" fill="none" stroke="url(#antgoGrad)" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>

    <!-- Chân đối xứng bên kia (Bóng chân sau) -->
    <path d="M 56 42 L 62 48 L 68 46" fill="none" stroke="url(#antgoGrad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.85"/>
    <path d="M 50 54 L 56 62 L 62 60" fill="none" stroke="url(#antgoGrad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.85"/>

    <!-- Thân & Đuôi Kiến tạo thành Tia Sét Đầy Uy Lực (Lightning Bolt Body) -->
    <path d="M 54 34 
             L 38 52 
             L 49 52 
             L 32 84 
             L 58 56 
             L 47 56 
             L 60 38 
             Z" 
          fill="url(#antgoGrad)"/>

    <!-- Khối bụng phụ phía sau kết nối tạo form con kiến -->
    <path d="M 28 58 C 22 62 18 69 22 75 C 24 78 28 77 31 74 L 32 70 Z" fill="url(#antgoGrad)" opacity="0.9"/>
  </g>
</svg>
